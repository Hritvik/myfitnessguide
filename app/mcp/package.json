{
  "name": "@myfitnessguide/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local stdio MCP server that wraps the MyFitnessGuide Worker API for Claude Code",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "myfitnessguide-mcp": "src/main.ts"
  },
  "scripts": {
    "start": "node src/main.ts",
    "smoke": "node src/smoke.ts",
    "latency": "node src/latency.ts",
    "pending": "node src/pending.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
